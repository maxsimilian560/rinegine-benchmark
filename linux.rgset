set {
  mode {
    clear,
    llvm,
    console,
    debug
  },
  var {
    compilator = "clang++",
    compilator32 = "clang++",
    source = "benchmark.cpp",
    bit = "64",
    run = false,
    name = "benchmark_runner",
    include = "-I../Rinegine/ -I/usr/local/include",       //[TODO]
    libs = "-L../Rinegine/ -L/usr/local/lib",             //[TODO]
    link = " -lrg-kernel -lbenchmark_main -lbenchmark -lpthread ",         //[TODO]
  }
},
add{
  var{
    // flags = "-O3 -march=native -std=c++23 -Wall -Wextra"  //[TODO]
    // flags = " -DRG_DEBUG -g -O3 -march=native -std=c++23 -Wall -Wextra "  //[TODO]
    flags = " -DEASTL_DEBUG=0 -DEASTL_NO_DEBUG_TRACKING=1 -O3 -march=native -std=c++23 -Wall -Wextra "  //[TODO]
  }
}
